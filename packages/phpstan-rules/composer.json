{
    "name": "toax4/phpstan-rules",
    "description": "Règles PHPStan custom réutilisables",
    "type": "phpstan-extension",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Apphalla\\PHPStanRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apphalla\\PHPStanRules\\Tests\\": "tests/"
        }
    }
}