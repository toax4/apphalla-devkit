{
    "name": "adrien/symfony-kit",
    "description": "Traits et utilitaires réutilisables pour projets Symfony/Doctrine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/string": "^6.4 || ^7.0",
        "symfony/translation-contracts": "^2.5 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Apphalla\\SymfonyKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apphalla\\SymfonyKit\\Tests\\": "tests/"
        }
    }
}